# =====================================================
# 2. IMAGE PREPROCESSING
# =====================================================

def preprocess_image(image):

    # Convert PIL image to grayscale
    image = image.convert("L")

    # Convert image into NumPy array
    image = np.array(image)

    # Detect handwritten digit
    _, binary = cv2.threshold(
        image,
        30,
        255,
        cv2.THRESH_BINARY
    )

    # Find digit boundaries
    coords = cv2.findNonZero(binary)

    if coords is None:
        return np.zeros(784, dtype=np.uint8)

    x, y, w, h = cv2.boundingRect(coords)

    # Crop the digit
    digit = binary[y:y+h, x:x+w]

    # Resize while maintaining aspect ratio
    scale = 20.0 / max(w, h)

    new_w = max(1, int(w * scale))
    new_h = max(1, int(h * scale))

    digit = cv2.resize(
        digit,
        (new_w, new_h),
        interpolation=cv2.INTER_AREA
    )

    # Place digit in a 28x28 black image
    final_image = np.zeros((28, 28), dtype=np.uint8)

    x_offset = (28 - new_w) // 2
    y_offset = (28 - new_h) // 2

    final_image[
        y_offset:y_offset+new_h,
        x_offset:x_offset+new_w
    ] = digit

    # Flatten 28x28 image into 784 features
    return final_image.flatten()


