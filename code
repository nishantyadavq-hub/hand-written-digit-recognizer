# =====================================================
# 6. DRAWING FUNCTIONS
# =====================================================

def start_drawing(event):

    global last_x, last_y

    last_x = event.x
    last_y = event.y

    # Draw a dot for a single click
    radius = 9

    draw.ellipse(
        (
            event.x-radius,
            event.y-radius,
            event.x+radius,
            event.y+radius
        ),
        fill=255
    )

    canvas.create_oval(
        event.x-radius,
        event.y-radius,
        event.x+radius,
        event.y+radius,
        fill="white",
        outline="white"
    )


def draw_digit(event):

    global last_x, last_y

    if last_x is not None and last_y is not None:

        # Draw on Tkinter canvas
        canvas.create_line(
            last_x,
            last_y,
            event.x,
            event.y,
            fill="white",
            width=18,
            capstyle=tk.ROUND,
            smooth=True
        )

        # Draw on PIL image
        draw.line(
            (last_x, last_y, event.x, event.y),
            fill=255,
            width=18
        )

        radius = 9

        draw.ellipse(
            (
                event.x-radius,
                event.y-radius,
                event.x+radius,
                event.y+radius
            ),
            fill=255
        )

    last_x = event.x
    last_y = event.y


def stop_drawing(event):

    global last_x, last_y

    last_x = None
    last_y = None


canvas.bind("<Button-1>", start_drawing)
canvas.bind("<B1-Motion>", draw_digit)
canvas.bind("<ButtonRelease-1>", stop_drawing)


# =====================================================
# 7. CLEAR CANVAS
# =====================================================

def clear_canvas():

    global drawing_image, draw
    global last_x, last_y

    canvas.delete("all")

    drawing_image = Image.new(
        "L",
        (CANVAS_SIZE, CANVAS_SIZE),
        0
    )

    draw = ImageDraw.Draw(drawing_image)

    last_x = None
    last_y = None

    result_label.config(
        text="Draw a digit from 0 to 9",
        fg="#173b70"
    )


# =====================================================
# 8. SAVE HANDWRITTEN DIGIT
# =====================================================

def save_sample():

    label = label_entry.get().strip()

    if not label.isdigit() or len(label) != 1:

        messagebox.showerror(
            "Invalid Label",
            "Please enter a digit between 0 and 9."
        )

        return

    if np.max(np.array(drawing_image)) == 0:

        messagebox.showerror(
            "Empty Canvas",
            "Please draw a digit first."
        )

        return

    folder = os.path.join(IMAGE_DIR, label)

    os.makedirs(folder, exist_ok=True)

    # Generate unique filename
    filename = str(uuid.uuid4()) + ".png"

    filepath = os.path.join(folder, filename)

    # Save original handwritten image
    drawing_image.save(filepath)

    messagebox.showinfo(
        "Sample Saved",
        f"Digit {label} saved successfully!"
    )

    clear_canvas()


# =====================================================
# 9. GENERATE DATASET
# =====================================================

def generate_dataset():

    features = []
    labels = []

    for label in range(10):

        folder = os.path.join(IMAGE_DIR, str(label))

        for filename in os.listdir(folder):

            if not filename.lower().endswith(".png"):
                continue

            filepath = os.path.join(folder, filename)

            try:

                image = Image.open(filepath)

                pixels = preprocess_image(image)

                features.append(pixels)
                labels.append(label)

            except Exception as e:

                print("Error reading image:", filepath, e)

    if len(features) == 0:

        messagebox.showerror(
            "Dataset Error",
            "No images found!\nSave handwritten samples first."
        )

        return

    columns = [
        "pixel" + str(i) for i in range(784)
    ]

    data = pd.DataFrame(
        features,
        columns=columns
    )

    data.insert(0, "label", labels)

    # Always overwrite old dataset
    data.to_csv(
        DATASET_PATH,
        index=False
    )

    messagebox.showinfo(
        "Dataset Generated",
        f"Dataset generated successfully!\n\n"
        f"Total Images: {len(data)}\n"
        f"Total Features: 784\n"
        f"Classes: {data['label'].nunique()}"
    )


# =====================================================
# 10. TRAIN SVM MODEL
# =====================================================

def train_model():

    if not os.path.exists(DATASET_PATH):

        messagebox.showerror(
            "Error",
            "Generate the dataset first."
        )

        return

    try:

        data = pd.read_csv(DATASET_PATH)

        if data.empty:

            messagebox.showerror(
                "Error",
                "Dataset is empty."
            )

            return

        X = data.drop("label", axis=1)

        Y = data["label"]

        # Check dataset dimensions
        if X.shape[1] != 784:

            messagebox.showerror(
                "Error",
                "Dataset must contain exactly 784 pixel features."
            )

            return

        if Y.nunique() < 2:

            messagebox.showerror(
                "Error",
                "Collect samples from at least two different digits."
            )

            return

        if Y.value_counts().min() < 2:

            messagebox.showerror(
                "Error",
                "Every digit class must have at least 2 samples."
            )

            return

        X, Y = shuffle(
            X,
            Y,
            random_state=42
        )

        # Split dataset into training and testing
        train_x, test_x, train_y, test_y = train_test_split(
            X,
            Y,
            test_size=0.5,
            random_state=42,
            stratify=Y
        )

        # Create SVM classifier
        classifier = SVC(
            kernel="linear",
            random_state=6
        )

        # Train using training data
        classifier.fit(
            train_x,
            train_y
        )

        # Predict testing data
        prediction = classifier.predict(test_x)

        accuracy = accuracy_score(
            test_y,
            prediction
        )

        # Train final model on complete dataset
        classifier.fit(X, Y)

        # Save trained model
        joblib.dump(
            classifier,
            MODEL_PATH
        )

        result_label.config(
            text=f"Model Accuracy: {accuracy * 100:.2f}%",
            fg="green"
        )

        messagebox.showinfo(
            "Training Completed",
            f"SVM Model Trained Successfully!\n\n"
            f"Training Samples: {len(train_x)}\n"
            f"Testing Samples: {len(test_x)}\n"
            f"Accuracy: {accuracy * 100:.2f}%"
        )

        print("\nClassification Report:\n")

        print(
            classification_report(
                test_y,
                prediction,
                zero_division=0
            )
        )

    except Exception as e:

        messagebox.showerror(
            "Training Error",
            str(e)
        )


# =====================================================
# 11. PREDICT HANDWRITTEN DIGIT
# =====================================================

def predict_digit():

    if not os.path.exists(MODEL_PATH):

        messagebox.showerror(
            "Model Not Found",
            "Please generate the dataset and train the model first."
        )

        return

    if np.max(np.array(drawing_image)) == 0:

        messagebox.showerror(
            "Empty Canvas",
            "Please draw a digit first."
        )

        return

    try:

        # Load trained model
        model = joblib.load(MODEL_PATH)

        # Preprocess current drawing
        pixels = preprocess_image(drawing_image)

        # Reshape into one sample
        pixels = pixels.reshape(1, 784)

        # Predict digit
        prediction = model.predict(pixels)

        predicted_digit = prediction[0]

        result_label.config(
            text=f"Predicted Digit: {predicted_digit}",
            fg="green"
        )

    except Exception as e:

        messagebox.showerror(
            "Prediction Error",
            str(e)
        )


